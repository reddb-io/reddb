from typing import Any, Awaitable, Callable

QueueHandler = Callable[[dict[str, Any]], Any | Awaitable[Any]]
QueueErrorHandler = Callable[[Exception, dict[str, Any] | None], Any | Awaitable[Any]]

class QueueClient:
    def __init__(self, transport: Any) -> None: ...
    def __call__(self, queue: str) -> ScopedQueueClient: ...
    def scope(self, queue: str) -> ScopedQueueClient: ...
    async def push(self, queue: str, value: Any, **opts: Any) -> dict[str, Any]: ...
    async def pop(self, queue: str, count: int | None = None) -> list[Any]: ...
    async def peek(self, queue: str, count: int | None = None) -> list[Any]: ...
    async def len(self, queue: str) -> int: ...
    async def purge(self, queue: str) -> dict[str, Any]: ...
    async def read_wait(self, queue: str, consumer: str, *, wait_ms: int,
        group: str | None = None, count: int | None = None) -> list[Any]: ...
    async def read_wait_entries(self, queue: str, consumer: str, *, wait_ms: int,
        group: str | None = None, count: int | None = None) -> list[dict[str, Any]]: ...

class ScopedQueueClient:
    name: str
    async def push(self, value: Any, **opts: Any) -> dict[str, Any]: ...
    async def read_wait_entries(self, consumer: str, *, wait_ms: int,
        group: str | None = None) -> list[dict[str, Any]]: ...
    async def ack(self, delivery_id: str) -> dict[str, Any]: ...
    async def nack(self, delivery_id: str, *, delay: str | None = None) -> dict[str, Any]: ...
    def consumer(self, *, consumer: str, handle_message: QueueHandler,
        group: str | None = None, wait_ms: int = 30000,
        retry_delay: str | None = None,
        on_error: QueueErrorHandler | None = None) -> QueueConsumer: ...

class QueueConsumer:
    @property
    def is_running(self) -> bool: ...
    def start(self) -> QueueConsumer: ...
    async def stop(self) -> None: ...
    async def wait(self) -> None: ...
