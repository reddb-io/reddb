{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reddb.io/schema/deployment-mode-matrix.json",
  "title": "Official driver deployment-mode qualification matrix",
  "type": "object",
  "required": ["version", "contract", "modes", "statuses", "drivers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "contract": { "type": "string" },
    "modes": {
      "type": "object",
      "required": ["serverless", "embedded", "server_replica", "cluster"],
      "additionalProperties": { "type": "string" }
    },
    "statuses": {
      "type": "object",
      "required": ["qualified", "partial", "missing"],
      "additionalProperties": { "type": "string" }
    },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "language", "facade", "package_roots", "four_mode_ready", "modes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "language": { "type": "string" },
          "facade": { "type": "string" },
          "package_roots": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "four_mode_ready": { "type": "boolean" },
          "modes": {
            "type": "object",
            "required": ["serverless", "embedded", "server_replica", "cluster"],
            "additionalProperties": {
              "type": "object",
              "required": ["status"],
              "additionalProperties": false,
              "properties": {
                "status": { "enum": ["qualified", "partial", "missing"] },
                "tests": { "type": "array", "items": { "type": "string" } },
                "gap": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
