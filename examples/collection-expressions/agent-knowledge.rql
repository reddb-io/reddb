CREATE TABLE knowledge_sources (source_key TEXT NOT NULL, observed_ms INTEGER NOT NULL, expires_ms INTEGER NOT NULL CHECK (expires_ms > observed_ms), lifetime_ms INTEGER GENERATED ALWAYS AS (expires_ms - observed_ms) STORED);
INSERT INTO knowledge_sources (source_key, observed_ms, expires_ms) VALUES ('manual-1', 1000, 61000);
SELECT source_key, lifetime_ms FROM knowledge_sources;
